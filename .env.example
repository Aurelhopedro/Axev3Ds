# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# GITHUB_CLIENT_ID: Required for GitHub Device Flow authentication.
# Create a GitHub App or OAuth App at https://github.com/settings/developers
# For Device Flow, use a GitHub App with "User authorization" enabled.
# This Client ID is NOT secret — it is safe to include in the APK.
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID_HERE
